//! Creates the main window sized to the monitor it opens on.
//!
//! The window is built at its final size instead of being created hidden and resized:
//! on Linux/Wayland, resizing before the first map leaves the GTK title-bar buttons
//! unclickable until the window state changes (e.g. a double-click maximize).

use tauri::{AppHandle, LogicalSize, Monitor, Runtime, WebviewUrl, WebviewWindow, WebviewWindowBuilder};

const LABEL: &str = "main";
const TITLE: &str = "GUI Gamma Launcher";
const PREFERRED: (f64, f64) = (1280.0, 900.0);
const MINIMUM: (f64, f64) = (860.0, 560.0);
/// Share of the screen the window may take, leaving room for panels/taskbars.
const SCREEN_FILL: f64 = 0.9;

fn monitor<R: Runtime>(app: &AppHandle<R>) -> Option<Monitor> {
    app.primary_monitor()
        .ok()
        .flatten()
        .or_else(|| app.available_monitors().ok()?.into_iter().next())
}

/// Preferred size, shrunk to fit the screen but never below the minimum.
fn fitted_size(screen: Option<LogicalSize<f64>>) -> (f64, f64) {
    let Some(screen) = screen else {
        return PREFERRED;
    };
    (
        PREFERRED.0.min(screen.width * SCREEN_FILL).max(MINIMUM.0),
        PREFERRED.1.min(screen.height * SCREEN_FILL).max(MINIMUM.1),
    )
}

pub fn create_main<R: Runtime>(app: &AppHandle<R>) -> tauri::Result<WebviewWindow<R>> {
    let screen = monitor(app).map(|m| m.size().to_logical::<f64>(m.scale_factor()));
    let (width, height) = fitted_size(screen);

    WebviewWindowBuilder::new(app, LABEL, WebviewUrl::default())
        .title(TITLE)
        .inner_size(width, height)
        .min_inner_size(MINIMUM.0, MINIMUM.1)
        .center()
        .build()
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn fits_screen() {
        assert_eq!(fitted_size(None), PREFERRED);
        assert_eq!(fitted_size(Some(LogicalSize::new(2560.0, 1440.0))), PREFERRED);
        let (w, h) = fitted_size(Some(LogicalSize::new(1366.0, 768.0)));
        assert!((w - 1229.4).abs() < 1e-6 && (h - 691.2).abs() < 1e-6);
        assert_eq!(fitted_size(Some(LogicalSize::new(800.0, 500.0))), MINIMUM);
    }
}
